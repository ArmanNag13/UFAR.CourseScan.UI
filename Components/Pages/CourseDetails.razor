@page "/courses"
@using Microsoft.EntityFrameworkCore
@using UFAR.PDFSync.DAO
@inject ApplicationDbContext DbContext
@rendermode InteractiveServer

<h2 class="text-center my-4 text-primary">📘 Course Catalog</h2>

<div class="container">
    <!-- Search & Filter Section -->
    <div class="mb-4 p-3 bg-light rounded shadow-sm sticky-bar">
        <div class="row g-2 w-100">
            <div class="col-md-6">
                <input class="form-control shadow-sm" placeholder="🔍 Search title, professor, or degree..."
                       value="@searchTerm"
                       @oninput="(e) => { searchTerm = e.Value?.ToString(); OnSearchInputChanged(); }" />
            </div>
            <div class="col-md-3">
                <select class="form-control shadow-sm"
                        value="@selectedLanguage"
                        @onchange="(e) => { selectedLanguage = e.Value?.ToString(); OnSearchInputChanged(); }">
                    <option value="">Filter by Language</option>
                    <option value="English">English</option>
                    <option value="French">French</option>
                    <option value="Armenian">Armenian</option>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-control shadow-sm"
                        value="@sortBy"
                        @onchange="(e) => { sortBy = e.Value?.ToString(); OnSearchInputChanged(); }">
                    <option value="Title">Sort by Title</option>
                    <option value="Professor">Sort by Professor</option>
                    <option value="AcademicYear">Sort by Academic Year</option>
                </select>
            </div>
        </div>
        <span class="badge bg-primary fs-6 mt-2">Total Courses: @filteredCourses?.Count()</span>
    </div>

    <!-- Courses Section -->
    @if (filteredCourses == null)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3">Loading courses...</p>
        </div>
    }
    else if (!filteredCourses.Any())
    {
        <div class="text-center my-5">
            <i class="fas fa-search fa-2x text-muted"></i>
            <p class="mt-3 text-muted">No matching courses found.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var course in PaginatedCourses)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="card-title text-primary">
                                <i class="fas fa-book me-2"></i>@course.Title
                            </h5>
                            <p class="mb-1"><strong>Professor:</strong> @course.Professor</p>
                            <p class="mb-2 text-muted">
                                <i class="fas fa-calendar-alt me-1"></i>@course.AcademicYear |
                                <i class="fas fa-graduation-cap ms-2 me-1"></i>@course.Degree
                            </p>
                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge bg-secondary">@course.Language</span>
                                <span class="badge bg-success">@course.CreditHours ECTS</span>
                                <span class="badge bg-info text-dark">@course.HoursCM h CM</span>
                                <span class="badge bg-warning text-dark">@course.HoursTD h TD</span>
                                <span class="badge bg-danger">@course.HoursTP h TP</span>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0">
                            <div class="d-flex justify-content-between">

                                <!-- Navigate to Course Detail Button -->
                                <button class="btn btn-outline-success ms-2" @onclick="() => NavigateToCourseDetail(course.Id)">
                                    <i class="fas fa-info-circle me-1"></i> View Details
                                </button>

                                <!-- Delete Course Button -->
                                <button class="btn btn-outline-danger ms-2" @onclick="() => DeleteCourse(course)">
                                    <i class="fas fa-trash me-1"></i> Delete
                                </button>
                            </div>


                            @if (expandedCourse == course)
                            {
                                <div class="mt-3 fade-in">
                                    @if (course.LearningOutcomes?.Any() == true)
                                    {
                                        <h6 class="text-primary"><i class="fas fa-lightbulb me-1"></i>Learning Outcomes</h6>
                                        <ul class="list-group list-group-flush">
                                            @foreach (var lo in course.LearningOutcomes)
                                            {
                                                <li class="list-group-item"><strong>@lo.Code:</strong> @lo.Description</li>
                                            }
                                        </ul>
                                    }

                                    @if (course.Assessments?.Any() == true)
                                    {
                                        <h6 class="text-primary mt-3"><i class="fas fa-check-square me-1"></i>Assessments</h6>
                                        <ul class="list-group list-group-flush">
                                            @foreach (var a in course.Assessments)
                                            {
                                                <li class="list-group-item">
                                                    <strong>@a.Type</strong> - @a.AssessmentMethod
                                                    @if (a.Duration != null)
                                                    {
                                                        <span>(@a.Duration h)</span>
                                                    }
                                                    <br />
                                                    <small>
                                                        Group: @a.GroupBased | Project: @a.ProjectRequired | Presentation: @a.PresentationRequired
                                                    </small>
                                                </li>
                                            }
                                        </ul>
                                    }

                                    @if (course.Syllabus?.Any() == true)
                                    {
                                        <h6 class="text-primary mt-3"><i class="fas fa-list-ul me-1"></i>Syllabus</h6>
                                        <ul class="list-group list-group-flush">
                                            @foreach (var s in course.Syllabus)
                                            {
                                                <li class="list-group-item">@s.Topic (@s.Hours h)</li>
                                            }
                                        </ul>
                                    }

                                    @if (course.References?.Any() == true)
                                    {
                                        <h6 class="text-primary mt-3"><i class="fas fa-bookmark me-1"></i>References</h6>
                                        <ul class="list-group list-group-flush">
                                            @foreach (var r in course.References)
                                            {
                                                <li class="list-group-item"><strong>@r.Title</strong> (@r.Year)</li>
                                            }
                                        </ul>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination Controls -->
        <div class="d-flex justify-content-center my-4">
            <button class="btn btn-outline-primary" @onclick="PreviousPage" disabled="@IsPreviousPageDisabled">Previous</button>
            <span class="mx-2">Page @currentPage of @totalPages</span>
            <button class="btn btn-outline-primary" @onclick="NextPage" disabled="@IsNextPageDisabled">Next</button>
        </div>
    }
</div>

@code {
    private List<Course> courses;
    private List<Course> filteredCourses;
    private string searchTerm = string.Empty;
    private Course expandedCourse;
    private string selectedLanguage = string.Empty;
    private string sortBy = "Title";

    private int currentPage = 1;
    private int pageSize = 3;
    private int totalPages => filteredCourses == null || !filteredCourses.Any()
        ? 1
        : (int)Math.Ceiling((double)filteredCourses.Count() / pageSize);
    private bool IsPreviousPageDisabled => currentPage == 1;
    private bool IsNextPageDisabled => currentPage == totalPages;

    protected override async Task OnInitializedAsync()
    {
        await LoadCourses();
    }

    private async Task LoadCourses()
    {
        courses = await DbContext.Courses
            .Include(c => c.LearningOutcomes)
            .Include(c => c.Assessments)
            .Include(c => c.TeachingMethods)
            .Include(c => c.Prerequisites)
            .Include(c => c.Syllabus)
            .Include(c => c.References)
            .ToListAsync();

        FilterCourses();
    }

    private void ToggleCourse(Course course)
    {
        expandedCourse = expandedCourse == course ? null : course;
    }

    private void FilterCourses()
    {
        var query = courses.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query = query.Where(c =>
                c.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                c.Degree.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                c.Professor.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrEmpty(selectedLanguage))
        {
            query = query.Where(c => c.Language == selectedLanguage);
        }

        filteredCourses = query.ToList();
        SortCourses();
    }

    private void SortCourses()
    {
        switch (sortBy)
        {
            case "Title":
                filteredCourses = filteredCourses.OrderBy(c => c.Title).ToList();
                break;
            case "Professor":
                filteredCourses = filteredCourses.OrderBy(c => c.Professor).ToList();
                break;
            case "AcademicYear":
                filteredCourses = filteredCourses.OrderBy(c => c.AcademicYear).ToList();
                break;
        }
    }

    private List<Course> PaginatedCourses => filteredCourses
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    private void PreviousPage()
    {
        if (currentPage > 1)
            currentPage--;
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
            currentPage++;
    }

    private async Task DeleteCourse(Course course)
    {
        try
        {
            DbContext.Courses.Remove(course);
            await DbContext.SaveChangesAsync();
            courses.Remove(course);
            FilterCourses();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting course: {ex.Message}");
        }
    }

    private void OnSearchInputChanged()
    {
        currentPage = 1;
        FilterCourses();
        StateHasChanged();
    }
    [Inject] public NavigationManager Navigation { get; set; }

    private void NavigateToCourseDetail(int courseId)
    {
        // Navigate to the course detail page for the specific course
        Navigation.NavigateTo($"/course-detail/{courseId}");
    }
}
