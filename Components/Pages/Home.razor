@page "/"

<style>
    body {
        background-image: url('images/background.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        margin: 0;
        font-family: sans-serif;
    }

    .overlay {
        padding: 2rem;
        max-width: 1200px;
        margin: 2rem auto;
    }

    .transparent-card {
        background-color: rgba(255, 255, 255, 0.6); /* Semi-transparent white */
        border-radius: 1rem;
        padding: 2rem;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(200, 200, 200, 0.4);
    }

    /* Flexbox layout for the 3 sections */
    .content-container {
        display: flex;
        justify-content: space-between;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .content-item {
        flex: 1 1 calc(33% - 2rem); /* Takes up 1/3 of the space with some margin */
        min-width: 280px; /* Ensures cards don't become too small on smaller screens */
    }

        flex: 1 1 100%; /* Stack the cards on smaller screens */
    }

    }
</style>

<div class="overlay text-gray-800">

    <div class="content-container">

        <!-- What is this platform? -->
        <div class="transparent-card content-item">
            <h2 class="text-3xl font-semibold text-blue-700 mb-4">What is this platform?</h2>
            <p class="text-lg leading-relaxed">
                The Course Planner is a tool that simplifies the management of course plans at UFAR.
                You can upload course PDFs and get structured data on:
            </p>
            <ul class="list-disc list-inside mt-4 text-lg space-y-2">
                <li>Course Title, Academic Year, and Language</li>
                <li>Learning Outcomes</li>
                <li>Assessments and Methods</li>
                <li>Teaching Methods, Syllabus, and References</li>
            </ul>
        </div>

        <!-- How to use it? -->
        <div class="transparent-card content-item">
            <h2 class="text-3xl font-semibold text-blue-700 mb-4">How to use it?</h2>
            <ol class="list-decimal list-inside space-y-3 text-lg">
                <li>Go to the <strong>Upload PDF</strong> page.</li>
                <li>Upload your course plan PDF(s).</li>
                <li>View the extracted course data on the <strong>Courses</strong> page.</li>
                <li>Click on any course for detailed information.</li>
            </ol>
        </div>

        <!-- Why use this tool? -->
        <div class="transparent-card content-item md:col-span-2">
            <h2 class="text-3xl font-semibold text-blue-700 mb-4">Why use this tool?</h2>
            <p class="text-lg leading-relaxed">
                Manual processing of course plans can be tedious and error-prone. The Course Planner ensures accuracy,
                saves time, and gives instant access to structured course data for better decision-making and efficiency.
            </p>
        </div>

    </div>
</div>
